{
  "name": "@dotrino/remote-agent",
  "version": "0.33.1",
  "description": "Middleware compartido del ecosistema Dotrino para apps de agente remoto cifrado punto a punto (handshake E2E, emparejamiento SAS con vault, revocación, descubrimiento). Lo consumen dotrino-terminal (PTY) y dotrino-ia (chat con IA).",
  "type": "module",
  "main": "./index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./index.js"
    },
    "./agent": {
      "types": "./types/src/agent.d.ts",
      "import": "./src/agent.js"
    },
    "./client": {
      "types": "./types/src/client.d.ts",
      "import": "./src/client.js"
    },
    "./link": {
      "types": "./types/src/link.d.ts",
      "import": "./src/link.js"
    },
    "./browser-link": {
      "types": "./types/src/browser-link.d.ts",
      "import": "./src/browser-link.js"
    },
    "./discover": {
      "types": "./types/src/discover.d.ts",
      "import": "./src/discover.js"
    },
    "./node-globals": {
      "types": "./types/node-globals.d.ts",
      "import": "./node-globals.js"
    },
    "./instances": {
      "types": "./types/src/instances.d.ts",
      "import": "./src/instances.js"
    }
  },
  "files": [
    "index.js",
    "e2e.js",
    "protocol.js",
    "node-globals.js",
    "src",
    "types"
  ],
  "scripts": {
    "test": "node --test 'test/**/*.test.js'",
    "type-check": "tsc --noEmit",
    "types": "node scripts/types.mjs"
  },
  "dependencies": {
    "@dotrino/compat": "0.5.0",
    "ws": "8.21.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/imdotrino/dotrino-remote-agent.git"
  },
  "homepage": "https://github.com/imdotrino/dotrino-remote-agent",
  "keywords": [
    "dotrino",
    "remote",
    "agent",
    "e2e",
    "vault",
    "proxy",
    "p2p"
  ],
  "peerDependencies": {
    "@dotrino/identity": ">=0.136.0",
    "@dotrino/proxy-client": ">=0.46.0",
    "@dotrino/vault": ">=0.115.0"
  },
  "devDependencies": {
    "@dotrino/identity": "0.136.0",
    "@dotrino/proxy-client": "0.47.0",
    "@dotrino/vault": "0.115.0",
    "@types/node": "22.20.1",
    "@types/ws": "8.18.1",
    "typescript": "5.9.3"
  }
}
